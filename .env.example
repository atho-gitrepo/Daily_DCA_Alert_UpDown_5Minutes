# ============================================================
# 🤖 AI TRADING BOT - ENVIRONMENT VARIABLES
# Super TDI + Super Bollinger Bands + Multi-Timeframe Strategy
# Version: 3.4.0 - UPDATED: MongoDB configuration for Railway
# ============================================================
#
# 📌 INSTRUCTIONS:
# 1. Copy this file to .env in the project root
# 2. Fill in your API keys and secrets
# 3. Adjust strategy parameters as needed
# 4. Never commit .env to version control!
# ============================================================

# ============================================================
# 🔐 SENSITIVE VARIABLES (Required for Production)
# ============================================================

# ---------- Binance API ----------
# Get from: https://www.binance.com/en/support/faq/how-to-create-api-keys-on-binance-360002502072
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
BINANCE_TESTNET=false

# ---------- Telegram Bot ----------
# Get from: @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
# Optional: Thread ID for separate signal channel
TELEGRAM_SIGNAL_THREAD_ID=

# ---------- MongoDB (NEW - Railway/Atlas) ----------
# Get from: MongoDB Atlas or Railway MongoDB plugin
# Option 1: Full connection string (recommended)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# Option 2: Individual components (for local development)
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_USER=your_mongodb_username
MONGODB_PASSWORD=your_mongodb_password
MONGODB_DB=trading_bot

# MongoDB Collections (Optional - Defaults shown)
MONGODB_ACTIVE_COLLECTION=active_signals
MONGODB_RESOLVED_COLLECTION=resolved_signals
MONGODB_ARCHIVE_COLLECTION=archive_signals

# MongoDB Connection Settings (Optional)
MONGODB_AUTH_SOURCE=admin
MONGODB_RETRY_WRITES=true
MONGODB_W=majority
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=5000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# ---------- Firebase (DEPRECATED - Keeping for backward compatibility) ----------
# Firebase is being replaced by MongoDB. These are kept for migration only.
# Firebase Console > Project Settings > Service Accounts
FIREBASE_CREDENTIALS_JSON=
FIREBASE_DATABASE_URL=
FIREBASE_ACTIVE_COLLECTION=active_signals
FIREBASE_RESOLVED_COLLECTION=resolved_signals
FIREBASE_ARCHIVE_COLLECTION=archive_signals
FIREBASE_HTF_OVERRIDE_COLLECTION=htf_overrides

# ---------- Groq AI ----------
# Get from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.3
GROQ_MAX_TOKENS=400

# ---------- Redis (Optional) ----------
# For distributed caching - get from Redis Cloud or self-hosted
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ============================================================
# ⚙️ STRATEGY VARIABLES (Optional - Override defaults)
# ============================================================

# ---------- TDI Parameters ----------
TDI_RSI_PERIOD=10
TDI_BB_LENGTH=20
TDI_FAST_MA_PERIOD=1
TDI_SLOW_MA_PERIOD=5

# ---------- Super Bollinger Bands ----------
BB_PERIOD=34
BB_DEV=1.750
BB_TREND_PERIOD=9

# ---------- TDI Trade Zones ----------
TDI_HARD_BUY_LEVEL=25.0
TDI_SOFT_BUY_LEVEL=35.0
TDI_CENTER_LINE=50.0
TDI_NO_TRADE_START=50.0
TDI_NO_TRADE_END=65.0
TDI_SOFT_SELL_LEVEL=65.0
TDI_HARD_SELL_LEVEL=75.0

# ---------- RRR & Risk ----------
DEFAULT_RRR=2.0
MIN_RRR=1.5
MAX_RRR=4.0
TARGET_RRR=2.5
MIN_RISK_PERCENT=0.001
MAX_RISK_PERCENT=0.015
MIN_SL_PERCENT=0.005
MAX_SL_PERCENT=0.015

# ---------- Signal Strength ----------
HARD_SIGNAL_MULTIPLIER=2.0
SOFT_SIGNAL_MULTIPLIER=1.0
HARD_SIGNAL_MIN_CONFIDENCE=0.70
SOFT_SIGNAL_MIN_CONFIDENCE=0.60

# ---------- Multi-Timeframe Settings ----------
ULTRA_LTF_MIN_CONFIDENCE=0.60
ULTRA_LTF_REQUIRED=false
LTF_MIN_CONFIDENCE=0.70
REQUIRE_LTF_CONFIRMATION=true
HTF_ALIGNMENT_THRESHOLD=0.70
REQUIRE_HTF_ALIGNMENT=true
ULTRA_HTF_MIN_CONFIDENCE=0.60
ULTRA_HTF_REQUIRED=false

# ---------- HTF Conflict Override - STRICT ----------
HTF_CONFLICT_QUALITY_THRESHOLD=85
HTF_CONFLICT_LTF_THRESHOLD=0.80
HTF_CONFLICT_REQUIRE_HARD=true

# ---------- LTF Settings ----------
LTF_RSI_PERIOD=10
LTF_EMA_FAST=9
LTF_EMA_SLOW=21

# ---------- HTF Settings ----------
HTF_EMA_PERIOD=20

# ---------- Ultra-HTF Settings ----------
ULTRA_HTF_EMA_PERIOD=50

# ---------- BB Filter ----------
MIN_BB_WIDTH=0.002
MAX_BB_WIDTH=0.03

# ---------- Signal Settings ----------
CONFIDENCE_THRESHOLD=0.60
MIN_QUALITY_SCORE=60
SIGNAL_COOLDOWN_MINUTES=30
MAX_SIGNALS_PER_HOUR=6
MAX_SIGNALS_PER_CYCLE=2

# ---------- Risk Management ----------
RISK_PER_TRADE_PERCENT=0.5
MAX_POSITION_SIZE_PERCENT=10.0
MAX_ACTIVE_SIGNALS=6

# ---------- Signal Lifecycle ----------
SYMBOL_COOLDOWN_MINUTES=30
BREAK_EVEN_THRESHOLD_MINUTES=480  # 8 hours
MIN_BARS_BEFORE_CHECK=2

# ---------- AI Settings ----------
AI_MIN_INTERVAL_SECONDS=60
AI_CACHE_TTL=300
AI_OVERRIDE_QUALITY_THRESHOLD=85
AI_MAX_TOKENS=400
AI_TEMPERATURE=0.3

# ---------- Fee & Leverage ----------
USE_FUTURES=true
FEE_IMPACT=0.0011
MAX_LEVERAGE=20
DEFAULT_LEVERAGE=5
MIN_LEVERAGE=1

# ---------- Leverage Profiles ----------
LEVERAGE_CONSERVATIVE=2.0
LEVERAGE_MODERATE=5.0
LEVERAGE_AGGRESSIVE=10.0
LEVERAGE_PROFESSIONAL=15.0
LEVERAGE_EXTREME=20.0

# ---------- Smart Money Concepts ----------
ENABLE_MSS=true
ENABLE_LIQUIDITY_SWEEP=true
ENABLE_FVG=true
ENABLE_SESSION_FILTER=true

# ---------- Market Regime ----------
REGIME_ADX_THRESHOLD=25.0
REGIME_VOLATILITY_THRESHOLD=0.02
REGIME_VOLUME_SURGE_THRESHOLD=2.0

# ---------- Heikin Ashi ----------
USE_HEIKIN_ASHI=true

# ---------- Confirmation Requirements ----------
REQUIRE_ULTRA_LTF=false
REQUIRE_LTF=true
REQUIRE_HTF_ALIGNMENT=true
REQUIRE_ULTRA_HTF=false

# ============================================================
# 📊 MARKET & SYMBOLS (Optional - Override defaults)
# ============================================================

QUOTE_ASSET=USDT
MAX_SYMBOLS=30

# Trading symbols (comma-separated)
SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT,ADAUSDT,DOGEUSDT,AVAXUSDT,DOTUSDT,TRXUSDT,BCHUSDT,LTCUSDT,UNIUSDT,NEARUSDT,ETCUSDT,XLMUSDT,APTUSDT,SUIUSDT,IMXUSDT,FILUSDT,ATOMUSDT,VETUSDT

# ---------- Timeframes ----------
ULTRA_LTF_TIMEFRAME=1m
LTF_TIMEFRAME=5m
TIMEFRAME=15m
HTF_TIMEFRAME=1h
ULTRA_HTF_TIMEFRAME=4h

# ---------- Data Fetching ----------
LOOKBACK_DAYS=7
POLLING_INTERVAL_SECONDS=30
API_TIMEOUT_SECONDS=5
BATCH_SIZE=100

# ============================================================
# 🚀 DEPLOYMENT (Optional - Override defaults)
# ============================================================

# Environment: development, staging, production
ENVIRONMENT=development

# Run Mode: DEMO, PRODUCTION, BACKTEST
RUN_MODE=DEMO

DEBUG=false
PORT=8080
HOST=0.0.0.0
RAILWAY_ENVIRONMENT=false
HEALTH_CHECK_PATH=/health
ENABLE_HEALTH_SERVER=true

# ============================================================
# 📝 LOGGING (Optional - Override defaults)
# ============================================================

LOG_LEVEL=INFO
LOG_FILE=logs/trading_bot.log
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_MAX_BYTES=10000000
LOG_BACKUP_COUNT=5
LOG_JSON=false
METRICS_ENABLED=true
METRICS_PORT=9090

# ============================================================
# ⚡ PERFORMANCE (Optional - Override defaults)
# ============================================================

CACHE_ENABLED=true
CACHE_TTL_SECONDS=30
CACHE_MAX_SIZE=1000
RATE_LIMIT_ENABLED=true
BINANCE_RATE_LIMIT=1200
BINANCE_ORDER_RATE_LIMIT=100
MAX_RETRIES=2
RETRY_DELAY_SECONDS=5
WEBSOCKET_ENABLED=true
WEBSOCKET_RECONNECT_DELAY=5
WEBSOCKET_MAX_RECONNECTS=10

# ============================================================
# 💰 TRADING CONFIGURATION (Optional - Override defaults)
# ============================================================

# Risk Management
MAX_TOTAL_RISK_CAPITAL_PERCENT=10.0
STOP_LOSS_BUFFER=0.002

# Take Profit Ratios (comma-separated)
TAKE_PROFIT_RATIOS=1.5,2.0,3.0

# ============================================================
# 🔧 BINANCE ADVANCED (Optional - Override defaults)
# ============================================================

BINANCE_REQUEST_TIMEOUT=30
BINANCE_RATE_LIMIT=1200
BINANCE_ORDER_RATE_LIMIT=100

# ============================================================
# 📌 NOTES
# ============================================================
#
# ⚠️ IMPORTANT:
# - Never commit .env to version control
# - Add .env to .gitignore
# - Use different API keys for testnet and mainnet
# - Test with testnet first before going live
# - Monitor rate limits to avoid being blocked
#
# 🔐 Security Tips:
# - Use read-only API keys when possible
# - Enable IP whitelisting for API keys
# - Rotate API keys regularly
# - Use environment-specific .env files (.env.dev, .env.prod)
#
# 🍃 MongoDB Setup:
# 1. Create a MongoDB Atlas cluster (free tier available)
# 2. Get your connection string from Atlas
# 3. Set MONGODB_URI in .env
# 4. Alternatively, use Railway's MongoDB plugin
#
# 📊 Strategy Notes:
# - TDI Levels: 25(HARD_BUY) → 35(SOFT_BUY) → 50(CENTER) → 65(SOFT_SELL) → 75(HARD_SELL)
# - HTF Override: Quality ≥ 85 AND LTF ≥ 80% AND HARD Signal
# - No Signal Expiry - Active until TP/SL/BreakEven
# - Break-Even Check: 8 hours
#
# 🎯 Recommended Settings:
# - Production: ENVIRONMENT=production, RUN_MODE=PRODUCTION
# - Testing: ENVIRONMENT=development, RUN_MODE=DEMO
# - Backtesting: RUN_MODE=BACKTEST
#
# 🚀 Railway Deployment:
# - Use Railway's MongoDB plugin or external Atlas
# - Set MONGODB_URI in Railway environment variables
# - Default port: 8080
#
# ============================================================
# ---------- Divergence Detection ----------
# Bullish/Bearish divergence between price and TDI
ENABLE_DIVERGENCE=true
DIVERGENCE_LOOKBACK=20
DIVERGENCE_MIN_STRENGTH=0.3

# ---------- Candle Pattern Recognition ----------
# Detects Doji, Engulfing, Hammer, Star patterns
ENABLE_CANDLE_PATTERNS=true
MIN_PATTERN_CONFIDENCE=0.5

# ---------- Support/Resistance Levels ----------
# Dynamic S/R levels for SL/TP placement
ENABLE_SR=true
SR_LOOKBACK=100
SR_NUM_LEVELS=3

# ---------- BB Squeeze Detection ----------
# Detects low volatility breakout opportunities
ENABLE_BB_SQUEEZE=true
SQUEEZE_THRESHOLD=0.6

# ---------- Session-Based Filtering ----------
# Adjusts confidence based on trading session
ENABLE_SESSION_FILTERING=true
SESSION_ASIAN_MULTIPLIER=0.7
SESSION_LONDON_MULTIPLIER=1.0
SESSION_NY_MULTIPLIER=1.2
SESSION_LATE_MULTIPLIER=0.8
