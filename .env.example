# ============================================================
# 🤖 AI TRADING BOT - ENVIRONMENT VARIABLES v3.4.1
# Super TDI + MACD + Super Bollinger Bands Strategy
# ============================================================

# ---------- Binance API ----------
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
BINANCE_USE_TESTNET=true

# ---------- Telegram Bot ----------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ---------- Groq AI ----------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.3
GROQ_ENABLED=true

# ---------- TDI Levels (Your RSI) ----------
TDI_OVERSOLD=25.0
TDI_SOFT_BUY=35.0
TDI_CENTER_LINE=50.0
TDI_SOFT_SELL=65.0
TDI_OVERBOUGHT=75.0
TDI_RSI_PERIOD=10
TDI_FAST_MA_PERIOD=1
TDI_SLOW_MA_PERIOD=5

# ---------- MACD Settings (NEW) ----------
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
REQUIRE_MACD_CONFIRMATION=true

# ---------- Bollinger Bands ----------
BB_PERIOD=34
BB_DEVIATION=1.75

# ---------- HTF Trend Following (DISABLED - Your manual strategy) ----------
REQUIRE_HTF_ALIGNMENT=false
HTF_TREND_THRESHOLD=1

# ---------- Grade Thresholds ----------
MIN_QUALITY_SCORE=50
GRADE_B_THRESHOLD=60
GRADE_C_THRESHOLD=50

# ---------- Strategy Conditions ----------
MIN_CONDITIONS_FOR_SIGNAL=3
HARD_SIGNAL_MIN_CONDITIONS=4
SOFT_SIGNAL_MIN_CONDITIONS=3

# ---------- Risk Management ----------
RISK_PER_TRADE_PERCENT=0.5
DEFAULT_LEVERAGE=5
MIN_RRR=1.5
DEFAULT_RRR=2.0
MAX_RRR=4.0

# ---------- Trading Settings ----------
SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT,AVAXUSDT,DOTUSDT,ADAUSDT,MATICUSDT
TIMEFRAME=5m
HTF_TIMEFRAME=1h
LTF_TIMEFRAME=1m
POLLING_INTERVAL_SECONDS=15

# ---------- Logging ----------
LOG_LEVEL=INFO

# ---------- Run Mode ----------
RUN_MODE=PRODUCTION
ENVIRONMENT=production
